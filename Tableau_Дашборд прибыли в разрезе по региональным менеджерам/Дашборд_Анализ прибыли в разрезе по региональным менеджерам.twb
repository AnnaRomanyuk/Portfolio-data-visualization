          <datasource-dependencies datasource='Parameters'>
            <column caption='Superprofit' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='3000'>
              <calculation class='tableau' formula='3000' />
            </column>
            <column caption='Quantity products' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
            </column>
