          <datasource-dependencies datasource='federated.04lmdss0mfukjm1cm6rpv106rieq'>
            <column caption='Classification of products by profit' datatype='string' name='[Calculation_2390285565733195779]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Profit]) &gt;= [Parameters].[Parameter 2] THEN &apos;Highly profitable&apos;&#13;&#10;ELSEIF SUM([Profit]) &lt; [Parameters].[Parameter 2] AND SUM([Profit]) &gt; 0 THEN &apos;Profitable&apos;&#13;&#10;ELSE &apos;Unprofitable&apos;&#13;&#10;END' />
            </column>
            <column caption='Filter by quantity' datatype='boolean' name='[Calculation_2390285565736013829]' role='dimension' type='nominal'>
